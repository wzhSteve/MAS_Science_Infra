# Environment variables for smolagents

# OpenAI API Key
OPENAI_API_BASE=<your-openai-api-base-url>
OPENAI_API_KEY=<your-openai-api-key>

# Search API
SERP_API_KEY=<your-serp-api-key>    # SerpAPI Key, you can get it from https://serpapi.com/
SERPER_API_KEY=<your-serper-api-key>    # Serper API Key, you can get it from https://serper.dev

# Hugging Face API Key
HF_TOKEN=<your-huggingface-api-key> # Hugging Face API Base URL, you can get it from https://huggingface.co