# Agent_Science_Infra 本地配置模板
# 复制为 .env 后填写：cp .env.example .env
# 优先级：进程已有环境变量 > .env > 代码默认值
# 加载入口：science_infra.env / run.sh / mas.workflow.env_load

# --- LLM（OpenAI-compatible / live-api）---
OPENAI_API_KEY=dummy
OPENAI_API_BASE=http://127.0.0.1:8000/v1
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=Qwen3-4B
# MODEL=Qwen3-4B

# --- Evaluation / LLM judge（与训练 OPENAI_MODEL 分离）---
# EVALUATION_MODEL_API_KEY=
# EVALUATION_MODEL_API_BASE=http://127.0.0.1:8000/v1
# EVALUATION_MODEL=gpt-4o

# === 出网代理（搜索 / Chrome / web_fetch）===
# 唯一主源。SSH RemoteForward 示例：RemoteForward 17890 127.0.0.1:12001
# 勿在本文件设 HTTP_PROXY/HTTPS_PROXY：会打坏本地 vLLM / rollout（LLM 侧用 trust_env=False）。
SCIENCE_INFRA_PROXY=http://127.0.0.1:17890
# 可选覆盖；空则 load_science_env 从 SCIENCE_INFRA_PROXY 回填
# WEB_SEARCH_PROXY=
# GOOGLE_CHROME_PROXY=
# CHROME_PROXY=

# === Bright Data SERP（付费；未设则本地 Bing + 上列代理）===
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_SERP_ZONES=serp_api1,serp_api2
# BRIGHT_DATA_SERP_ZONE=serp_api1
# BRIGHT_DATA_MODE=auto
# BRIGHT_DATA_TIMEOUT=45
# BRIGHT_DATA_MAX_RETRIES=2

# --- 搜索超参数 ---
# TIR_SEARCH_DESC_CHARS=200
# TIR_SEARCH_MAX_CHARS=2000
# TIR_SEARCH_MAX_RESULTS=10
# TIR_OFFLINE_SEARCH=0

# === 本地服务端口（非 Clash）===
# VLLM_HOST=127.0.0.1
# VLLM_PORT=8000
# VLLM_MODEL_PATH=/root/autodl-tmp/LLM/Qwen3-4B
# VLLM_SERVED_NAME=Qwen3-4B
# VLLM_GPU_MEM=0.45
# VLLM_MAX_MODEL_LEN=8192
# VLLM_LOG=/tmp/vllm_science_infra.log
# UI_PORT=8787
# FORWARD_LISTEN_PORT=6006
# AGL_METRICS_ORIGIN=http://127.0.0.1:4747

# --- 其它可选 ---
# TENSORBOARD_DIR=
# TIR_ARCHIVE_DIR=
# TIR_MAS_HEALTH=1
