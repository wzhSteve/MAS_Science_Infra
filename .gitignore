# Local secrets / machine config
.env
.secrets.env
!.env.example

# Browser runtime profiles
chrome_profile/
.chrome_profile/

# Smoke / collect artifacts
artifacts/
**/artifacts/

# Training / runtime outputs (too large for GitHub)
/checkpoints/
/logs/
/backups/
.ipynb_checkpoints/

# Accidental lock / stray files
/1
/1.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

node_modules/

.github

.tir_archives
online
offline
agent-lightning/docs

# Exclude datasets, runtime screenshots, and model weights
/data/*.parquet
/agent-lightning/examples/ARPO/ARPO/rl_datasets/
/agent-lightning/examples/ARPO/LLaMA-Factory/arpo_train_sft/dataset/
/agent-lightning/examples/CD_TAA/solver_cache/
model.safetensors

# User-space: track project source; skip upload packages and runtime junk
/user_space/projects/*.zip
/user_space/projects/**/test_status.log
/user_space/projects/**/artifacts/
__MACOSX/
**/__MACOSX/

